{
  "name": "kubernetes-handbook",
  "version": "1.0.0",
  "private": true,
  "description": "Kubernetes Handbook",
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "engines": {
    "node": "24.21.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "node scripts/check-book.mjs --source-only && honkit build . _book",
    "serve": "node --require ./scripts/serve-loopback.cjs ./node_modules/honkit/bin/honkit.js serve . _book",
    "epub": "honkit epub . kubernetes-handbook.epub",
    "pdf": "honkit pdf . kubernetes-handbook.pdf",
    "mobi": "honkit mobi . kubernetes-handbook.mobi",
    "check:book": "node scripts/check-book.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "gitbook-plugin-editlink": "1.0.2",
    "gitbook-plugin-tbfed-pagefooter": "0.0.1",
    "honkit": "6.2.2",
    "honkit-plugin-handbook-rendering": "file:plugins/handbook-rendering",
    "mermaid": "12.1.0",
    "gitbook-plugin-search-plus": "1.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fun-ed/kubernetes-handbook.git"
  },
  "author": "",
  "license": "CC-BY-NC-SA-4.0",
  "bugs": {
    "url": "https://github.com/fun-ed/kubernetes-handbook/issues"
  },
  "homepage": "https://github.com/fun-ed/kubernetes-handbook#readme"
}
